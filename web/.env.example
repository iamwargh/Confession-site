# ==============================================================================
# OFFCHEST / CONFESSION SITE — ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT:
# - NEVER commit real credentials to GitHub.
# - Keep .env.local and all .env* files in .gitignore.
# ==============================================================================

# Supabase Public Configuration (Accessible in browser)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER expose to browser)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role secret
# Used by administrative server actions and account deletion
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Application URL
# Local: http://localhost:3000 | Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth 2.0 Credentials (Direct server-side OAuth exchange)
# Found in: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret-placeholder

